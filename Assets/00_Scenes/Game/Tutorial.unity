  m_IsActive: 1
--- !u!114 &584153687
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 584153686}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b99c6e9e6eb82c4184564a9fa9a0937, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 20219518}
  speakerNameText: {fileID: 1483557127}
  dialogueText: {fileID: 242769855}
  portraitImage: {fileID: 1058245288}
  portraitCanvas: {fileID: 1058245285}
  guideSprite: {fileID: 21300000, guid: ed8419115851dc6478f7f62fdd7110ba, type: 3}
  voiceSource: {fileID: 584153689}
  voiceVolume: 1
  typingSpeed: 0.03
  autoAdvanceDelay: 1
  autoAdvance: 1
  startingDialogue:
  - speakerName: "Gu\xEDa"
    text: "\xA1Agh! Por fin despiertas, lata con patas."
    voiceClip: {fileID: 8300000, guid: cd623f276761ba444a76ef6d40a76a02, type: 3}
  - speakerName: PepsiMan
    text: "\xBFD\xF3nde estoy?\""
    voiceClip: {fileID: 8300000, guid: 530b0811f0d6b5f47bb72813181ed7ba, type: 3}
  - speakerName: "Gu\xEDa"
    text: "En la F\xE1brica Pepsi Empire\u2026 o su cad\xE1ver, depende del d\xEDa."
    voiceClip: {fileID: 8300000, guid: 1e50d7cf66970d445b4b06120258b275, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Primero: dale energ\xEDa a esa m\xE1quina de energ\xEDa"
    voiceClip: {fileID: 8300000, guid: bd928cf84d4ae4846a1ab53e6ae81ce8, type: 3}
  - speakerName: PepsiMan
    text: "\xBFY si me da corriente?"
    voiceClip: {fileID: 8300000, guid: a8c6e304ce43dc04d9917b1d8fdb930b, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Perfecto, brillar\xE1s por fin."
    voiceClip: {fileID: 8300000, guid: f614a3570e9d07d45bf6b80b482dd1ba, type: 3}
  - speakerName: "Gu\xEDa"
    text: "\xA1Bien! No moriste. Eso ya es productividad."
    voiceClip: {fileID: 8300000, guid: dc7353ab4e216de4da7d9d196b9e7c91, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Ahora ve a la m\xE1quina de esencia y saca esencia."
    voiceClip: {fileID: 8300000, guid: 48761d03161a97b4cbb42f1225224c87, type: 3}
  - speakerName: Pepsiman
    text: Huele raro.
    voiceClip: {fileID: 8300000, guid: f63e6199a4253b548a0d36090f0ced4f, type: 3}
  - speakerName: "Gu\xEDa"
    text: "As\xED huele el \xE9xito... y los qu\xEDmicos."
    voiceClip: {fileID: 8300000, guid: a337b185d515c294ba1b56fe2630762b, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Genial. No la bebas, todav\xEDa no tenemos seguro m\xE9dico."
    voiceClip: {fileID: 8300000, guid: 85e3368a06a8b4141be0d710263bcf09, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Recoge los ingredientes en la m\xE1quina de ingredientes."
    voiceClip: {fileID: 8300000, guid: 810f7eb486548404fb437f749b1a1846, type: 3}
  - speakerName: Pepsiman
    text: "\xBFCu\xE1les?"
    voiceClip: {fileID: 8300000, guid: 2599889e5a1a98640b103ccaa24f633c, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Los que no exploten, empieza por ah\xED."
    voiceClip: {fileID: 8300000, guid: 18fac2187f5c1244d8d56a5ddbf89b7c, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Perfecto. M\xE1s adelante podr\xE1s mezclar para crear nuevos sabores."
    voiceClip: {fileID: 8300000, guid: 53c159e5a9c37824eb6de2c2e699d244, type: 3}
  - speakerName: Pepsiman
    text: "\xBFPepsi sabor \xE9xito?"
    voiceClip: {fileID: 8300000, guid: 4dc07370c83fa4d429d3a53cd62611ba, type: 3}
  - speakerName: "Gu\xEDa"
    text: Jajaja, suerte con eso.
    voiceClip: {fileID: 8300000, guid: 967f7d38466965a47a6bd69fa1c98382, type: 3}
  - speakerName: "Gu\xEDa"
    text: Hora de mezclarlo todo en la mezcladora.
    voiceClip: {fileID: 8300000, guid: 1009ab57a1e0554488db14699505ea46, type: 3}
  - speakerName: Pepsiman
    text: "\xBFEs seguro?"
    voiceClip: {fileID: 8300000, guid: 37e98eb6298869a48b86fc1bebdfdfee, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Nada aqu\xED lo es."
    voiceClip: {fileID: 8300000, guid: d87ac27162111b14c8637e021c26baec, type: 3}
  - speakerName: "Gu\xEDa"
    text: Ahora embotella tu obra maestra en la embotelladora.
    voiceClip: {fileID: 8300000, guid: a95288e6d3f57eb4487d193f69e8cff6, type: 3}
  - speakerName: Pepsiman
    text: "\xBFDe verdad se toma esto?"
    voiceClip: {fileID: 8300000, guid: 76dc14cd9a554854a8e41f26f073785c, type: 3}
  - speakerName: "Gu\xEDa"
    text: Con fe y algo de inconsciencia.
    voiceClip: {fileID: 8300000, guid: bd2cdd5064caee94b9cbe9a8c6774dec, type: 3}
  - speakerName: "Gu\xEDa"
    text: "\xA1Listo! Tu primera Pepsi."
    voiceClip: {fileID: 8300000, guid: cd59034232250bd46bc450ebb4d4fed5, type: 3}
  - speakerName: Pepsiman
    text: "\xBFY ahora?\""
    voiceClip: {fileID: 8300000, guid: 13618e088eec88340825d29ac07fd2b5, type: 3}
  - speakerName: "Gu\xEDa"
    text: Ahora trabaja. O inventa un sabor nuevo. Pero sin incendiar nada.
    voiceClip: {fileID: 8300000, guid: dcf9a476d0bb8374982a8a9ed8f8dadc, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Mira eso, visitantes que estan afuera de la fabrica. Pens\xE9 que este
      lugar ya no le importaba a nadie."
    voiceClip: {fileID: 8300000, guid: f869139257dfdd94aa6a70d0b952d31a, type: 3}
  - speakerName: Pepsiman
    text: "\xBFPor qu\xE9 est\xE1n... sin color?"
    voiceClip: {fileID: 8300000, guid: 0f5871a978abd45468341542eae53602, type: 3}
  - speakerName: "Gu\xEDa"
    text: "As\xED llega la gente cuando olvida el sabor de la vida. Sin chispa, sin
      gas... solo rutina."
    voiceClip: {fileID: 8300000, guid: e4dfefd94ae7c8246aaf58928e162b8f, type: 3}
  - speakerName: "Gu\xEDa"
    text: Pero una Pepsi buena puede hacerlos recordar. Literalmente.
    voiceClip: {fileID: 8300000, guid: 194132c0f97138f41adfbf1c925b5622, type: 3}
  - speakerName: "Gu\xEDa"
    text: Esa la que esta en medio de la fabricas es la PepsiWoman. No habla, pero
      vende caro.
    voiceClip: {fileID: 8300000, guid: fc3f1dcbfdc728f459f263a500d1017a, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Ac\xE9rcate a ella si quieres mejorar tus m\xE1quinas\u2026 o tu autoestima."
    voiceClip: {fileID: 8300000, guid: 8c98e4d6330ded74dbdec3b72c26f3f2, type: 3}
  - speakerName: "Gu\xEDa"
    text: "No te asustes si te mira raro, as\xED mira a todos los que tienen poco
      dinero."
    voiceClip: {fileID: 8300000, guid: 59607fb0bc9bf304dbd08a6172c23b98, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Bienvenido al capitalismo burbujeante. Aqu\xED gastas lo que ganas\u2026
      y lloras despu\xE9s."
    voiceClip: {fileID: 8300000, guid: 7df2ff628538de341a210a68927b8e7b, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Elige una mejora. O qu\xE9date pobre, tambi\xE9n es una estrategia."
    voiceClip: {fileID: 8300000, guid: 3c8dc0cb648d71243b24060745e1ea69, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Cada mejora hace que la f\xE1brica funcione mejor. A diferencia de ti,
      que solo te cansas."
    voiceClip: {fileID: 8300000, guid: 75b4d79bdc5e64a428074313c37c60bd, type: 3}
  - speakerName: "Gu\xEDa"
    text: "Y cuando te canses de salvar el imperio con tanto estilo, ve a tu cama
      y duerme. S\xED, dormir\u2026 esa funci\xF3n olvidada de los h\xE9roes con
      cafe\xEDna."
    voiceClip: {fileID: 8300000, guid: 0cc0a3a7dc1e94143acdf2326905cea4, type: 3}
  - speakerName: "Gu\xEDa"
    text: "El tutorial se acab\xF3. No celebres, apenas empiezas."
    voiceClip: {fileID: 8300000, guid: 94cae0ed9397cde44aa045dc4bab180d, type: 3}
  isPausedByTutorial: 0
