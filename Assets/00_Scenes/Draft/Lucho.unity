  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 652038665}
  speakerNameText: {fileID: 863096420}
  dialogueText: {fileID: 889511233}
  portraitImage: {fileID: 2122702135}
  portraitCanvas: {fileID: 2122702132}
  guideSprite: {fileID: 21300000, guid: ed8419115851dc6478f7f62fdd7110ba, type: 3}
  typingSpeed: 0.03
  autoStart: 1
  startingDialogue:
  - speakerName: "Gu\xEDa"
    text: "Primero necesitaremos esencia, y te gustar\xE1 c\xF3mo se consigue\u2026
      a menos que seas, ya sabes\u2026\r\n"
  - speakerName: PepsiMan
    text: No me esperaba eso, pero fue agradable.
  - speakerName: "Gu\xEDa"
    text: "Ve hasta la m\xE1quina de energ\xEDa y rec\xE1rgala."
  - speakerName: PepsiMan
    text: Listo
  - speakerName: "Gu\xEDa"
    text: "Ahora ve hasta la m\xE1quina de esencia y extrae la base del sabor."
  - speakerName: Pepsiman
    text: mmmm
  - speakerName: "Gu\xEDa"
    text: "Perfecto, ve a la m\xE1quina de ingredientes y prepara la mezcla"
  - speakerName: Pepsiman
    text: carajo
  - speakerName: "Gu\xEDa"
    text: Luego usa la mezcladora para combinar la esencia.
  - speakerName: Pepsiman
    text: mmmm
  - speakerName: "Gu\xEDa"
    text: Finalmente, utiliza la embotelladora para sellar las botellas.
  - speakerName: "Gu\xEDa"
    text: xd
  isPausedByTutorial: 0
